# Postgres connection string. On Vercel, add a Neon (or other Postgres) database and it fills this in.
DATABASE_URL="postgresql://ttb:ttb@localhost:5432/ttb"

# Long random string used to sign login sessions. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Which providers send OTP codes and take payments. "mock" = nothing is really sent or charged.
OTP_PROVIDER="mock"
PAYMENT_PROVIDER="mock"

# Only when PAYMENT_PROVIDER="omise". Omise Dashboard → Keys. Test keys (pkey_test_ / skey_test_) move no real money.
# OMISE_PUBLIC_KEY="pkey_test_..."
# OMISE_SECRET_KEY="skey_test_..."

# When "true", the OTP code is shown on screen so testers can sign up without a real SMS/email.
SHOW_TEST_OTP="true"
